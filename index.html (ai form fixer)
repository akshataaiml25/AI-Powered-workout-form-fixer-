/* ============================================================
   WARM-UP COUNTDOWN
   ============================================================ */
function startCountdown(onDone) {
  const overlay = document.getElementById('countdownOverlay');
  const numEl = document.getElementById('countdownNum');
  const lblEl = document.getElementById('countdownLabel');
  overlay.style.display = 'flex';
  let count = 3;

  function tick() {
    if (count > 0) {
      numEl.textContent = count;
      lblEl.textContent = count === 3 ? 'Get ready...' : count === 2 ? 'Set your position' : 'Go!';
      gsap.fromTo(numEl, { scale:1.4, opacity:0 }, { scale:1, opacity:1, duration:0.35 });
      count--;
      setTimeout(tick, 900);
    } else {
      overlay.style.display = 'none';
      onDone();
    }
  }
  tick();
}

/* ============================================================
   JOINT ANGLE MATH (dot-product method — more robust)
   ============================================================ */
function calcAngle(a, b, c) {
  const ax = a.x - b.x, ay = a.y - b.y;
  const cx = c.x - b.x, cy = c.y - b.y;
  const dot = ax * cx + ay * cy;
  const cross = ax * cy - ay * cx;
  const angle = Math.atan2(Math.abs(cross), dot) * 180 / Math.PI;
  return Math.max(0, Math.min(180, angle));
}

function lm(landmarks, idx) {
  const p = landmarks[idx];
  return { x: p.x, y: p.y, z: p.z || 0, vis: p.visibility || 0 };
}

function smoothAngle(buf, val, n) {
  buf.push(val);
  if (buf.length > n) buf.shift();
  return buf.reduce((s, v) => s + v, 0) / buf.length;
}

/* ============================================================
   FPS TRACKING
   ============================================================ */
let frameCount = 0, lastFpsMs = Date.now();

function trackFPS() {
  frameCount++;
  const now = Date.now();
  if (now - lastFpsMs >= 1000) {
    state.fps = frameCount;
    frameCount = 0;
    lastFpsMs = now;
    const el = document.getElementById('fpsPill');
    if (el) {
      el.textContent = `${state.fps} FPS`;
      el.style.color = state.fps >= 24 ? 'var(--good)' : state.fps >= 15 ? 'var(--warn)' : 'var(--bad)';
    }
  }
}

/* ============================================================
   POSE RESULTS HANDLER
   ============================================================ */
function onPoseResults(results) {
  if (!state.poseActive) return;

  const canvas = document.getElementById('poseCanvas');
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  trackFPS();

  if (!results.poseLandmarks || results.poseLandmarks.length < 29) {
    updateStatus('No person detected — step into frame', 'warn');
    return;
  }

  const landmarks = results.poseLandmarks;

  // Confidence (average visibility of key landmarks)
  const keyIdxs = [11,12,13,14,15,16,23,24,25,26,27,28];
  const avgVis = keyIdxs.reduce((s,i) => s + (landmarks[i]?.visibility || 0), 0) / keyIdxs.length;
  state.confidence = Math.round(avgVis * 100);
  const confEl = document.getElementById('confPill');
  if (confEl) confEl.textContent = `${state.confidence}% conf`;

  // Calculate all angles
  const kneeL   = calcAngle(lm(landmarks, LM.LEFT_HIP),      lm(landmarks, LM.LEFT_KNEE),   lm(landmarks, LM.LEFT_ANKLE));
  const kneeR   = calcAngle(lm(landmarks, LM.RIGHT_HIP),     lm(landmarks, LM.RIGHT_KNEE),  lm(landmarks, LM.RIGHT_ANKLE));
  const hipL    = calcAngle(lm(landmarks, LM.LEFT_SHOULDER), lm(landmarks, LM.LEFT_HIP),    lm(landmarks, LM.LEFT_KNEE));
  const hipR    = calcAngle(lm(landmarks, LM.RIGHT_SHOULDER),lm(landmarks, LM.RIGHT_HIP),   lm(landmarks, LM.RIGHT_KNEE));
  const elbowL  = calcAngle(lm(landmarks, LM.LEFT_SHOULDER), lm(landmarks, LM.LEFT_ELBOW),  lm(landmarks, LM.LEFT_WRIST));
  const elbowR  = calcAngle(lm(landmarks, LM.RIGHT_SHOULDER),lm(landmarks, LM.RIGHT_ELBOW), lm(landmarks, LM.RIGHT_WRIST));

  // Smooth all angles
  const sKneeL  = smoothAngle(state.angleBuffers.a, kneeL, state.SMOOTH_N);
  const sKneeR  = smoothAngle(state.angleBuffers.b, kneeR, state.SMOOTH_N);
  const sHipL   = smoothAngle(state.angleBuffers.c, hipL, state.SMOOTH_N);
  const sElbowL = smoothAngle(state.angleBuffers.d, elbowL, state.SMOOTH_N);

  const angles = { kneeL:sKneeL, kneeR:sKneeR, hipL:sHipL, hipR, elbowL:sElbowL, elbowR };
  state.lastAngles = angles;

  // Exercise-specific processing
  const issues = [];
  if (state.exercise === 'squat')  processSquat(landmarks, angles, issues);
  else if (state.exercise === 'pushup') processPushup(landmarks, angles, issues);
  else if (state.exercise === 'press')  processPress(landmarks, angles, issues);
  else if (state.exercise === 'curl')   processCurl(landmarks, angles, issues);

  // Update angle display per exercise
  updateAnglesDisplay(angles);

  // Form status
  state.formGood = issues.length === 0;
  const dot = document.getElementById('statusDot');
  if (issues.length > 0) {
    dot.className = 'status-dot bad';
    updateStatus(issues[0]);
  } else {
    dot.className = 'status-dot';
    updateStatus('Good form — keep it up!');
  }

  // Draw skeleton
  drawSkeleton(ctx, landmarks, canvas.width, canvas.height, state.formGood);
  drawAngleOverlay(ctx, landmarks, canvas.width, canvas.height, angles);
}

/* ============================================================
   ANGLE DISPLAY (per exercise)
   ============================================================ */
function updateAnglesDisplay(angles) {
  const meta = EXERCISE_META[state.exercise];
  let vals;

  if (state.exercise === 'squat') {
    vals = [
      { id:'A', val:angles.kneeL,  min:60, max:170 },
      { id:'B', val:angles.kneeR,  min:60, max:170 },
      { id:'C', val:angles.hipL,   min:60, max:180 },
      { id:'D', val:angles.hipR,   min:60, max:180 },
    ];
  } else if (state.exercise === 'pushup') {
    vals = [
      { id:'A', val:angles.elbowL, min:60, max:180 },
      { id:'B', val:angles.elbowR, min:60, max:180 },
      { id:'C', val:angles.hipL,   min:140, max:180 },
      { id:'D', val:angles.hipR,   min:140, max:180 },
    ];
  } else if (state.exercise === 'press') {
    vals = [
      { id:'A', val:angles.elbowL, min:60, max:180 },
      { id:'B', val:angles.elbowR, min:60, max:180 },
      { id:'C', val:angles.hipL,   min:140, max:180 },
      { id:'D', val:angles.hipR,   min:140, max:180 },
    ];
  } else { // curl
    vals = [
      { id:'A', val:angles.elbowL, min:30, max:170 },
      { id:'B', val:angles.elbowR, min:30, max:170 },
      { id:'C', val:angles.hipL,   min:140, max:180 },
      { id:'D', val:angles.hipR,   min:140, max:180 },
    ];
  }

  vals.forEach(({ id, val, min, max }) => {
    const el = document.getElementById('ang' + id);
    const bar = document.getElementById('bar' + id);
    if (!el || !bar) return;
    el.textContent = `${Math.round(val)}°`;
    const pct = Math.min(100, Math.max(0, (val - min) / (max - min) * 100));
    bar.style.width = pct + '%';
  });
}

function updateStatus(text) {
  document.getElementById('statusText').textContent = text;
  document.getElementById('dockStatus').textContent = text;
}

/* ============================================================
   EXERCISE: SQUAT
   ============================================================ */
function processSquat(lms, angles, issues) {
  const avgKnee = (angles.kneeL + angles.kneeR) / 2;

  // Rep state machine: neutral → down (knee < 115°) → up (knee > 160°)
  if (avgKnee < 115 && state.repState !== 'down') {
    state.repState = 'down';
  } else if (avgKnee > 160 && state.repState === 'down') {
    const now = Date.now();
    if (now - state.lastRepTime > 900) {
      state.lastRepTime = now;
      state.repState = 'neutral';
      countRep(state.formGood);
    }
  }

  // Form checks
  if (avgKnee < 55) {
    issues.push('Too deep — ease up');
    audioCorrection('squat_deep', 'Watch your depth — you\'re going too deep. Aim for parallel.');
  }
  if (angles.hipL < 85 && avgKnee < 130) {
    issues.push('Lean forward — chest up');
    audioCorrection('squat_chest', 'Keep your chest up and your back straight as you squat down.');
  }

  // Knee cave detection
  const lKneeX = lms[LM.LEFT_KNEE].x, lAnkleX = lms[LM.LEFT_ANKLE].x;
  const rKneeX = lms[LM.RIGHT_KNEE].x, rAnkleX = lms[LM.RIGHT_ANKLE].x;
  if (Math.abs(lKneeX - lAnkleX) > 0.09 || Math.abs(rKneeX - rAnkleX) > 0.09) {
    issues.push('Knees caving in');
    audioCorrection('squat_knees', 'Push your knees outward — they should track over your toes.');
  }

  // Depth encouragement
  if (state.repState === 'down' && canSpeak('squat_depth_good', 5000)) {
    if (avgKnee >= 88 && avgKnee <= 115 && issues.length === 0) {
      speak(randomChoice(['Good depth — hold and drive.', 'Nice depth! Now explode up.', 'Perfect parallel — push through your heels.']));
    }
  }
}

/* ============================================================
   EXERCISE: PUSH-UP
   ============================================================ */
function processPushup(lms, angles, issues) {
  const avgElbow = (angles.elbowL + angles.elbowR) / 2;
  const hip = lms[LM.LEFT_HIP];
  const shoulder = lms[LM.LEFT_SHOULDER];
  const ankle = lms[LM.LEFT_ANKLE];

  // Rep detection: down (elbow < 90°) → up (elbow > 155°)
  if (avgElbow < 90 && state.repState !== 'down') {
    state.repState = 'down';
  } else if (avgElbow > 155 && state.repState === 'down') {
    const now = Date.now();
    if (now - state.lastRepTime > 700) {
      state.lastRepTime = now;
      state.repState = 'neutral';
      countRep(state.formGood);
    }
  }

  // Hip sag detection
  const bodyLineDiff = hip.y - (shoulder.y + (ankle.y - shoulder.y) * 0.5);
  if (bodyLineDiff > 0.1) {
    issues.push('Hips sagging — core tight');
    audioCorrection('pushup_hips', 'Hips are sagging — engage your core and keep a straight body line.');
  }

  // Hip pike
  if (bodyLineDiff < -0.12) {
    issues.push('Hips too high — lower them');
    audioCorrection('pushup_pike', 'Your hips are too high. Lower them to form a straight line.');
  }

  // Elbow flare
  if (angles.elbowL < 90 && angles.elbowL > 30) {
    const lShoulderX = lms[LM.LEFT_SHOULDER].x, lElbowX = lms[LM.LEFT_ELBOW].x;
    if (Math.abs(lShoulderX - lElbowX) > 0.1) {
      issues.push('Elbows flaring — tuck them');
      audioCorrection('pushup_flare', 'Tuck your elbows closer to your torso — about 45 degrees from your body.');
    }
  }

  // Full extension reminder
  if (state.repState === 'down' && avgElbow > 155 && canSpeak('pushup_lockout', 5000)) {
    speak(randomChoice(['Good rep! Keep that body rigid.', 'Strong push — stay rigid!', 'Great form — chest to floor next.']));
  }
}

/* ============================================================
   EXERCISE: SHOULDER PRESS
   ============================================================ */
function processPress(lms, angles, issues) {
  const wristL = lms[LM.LEFT_WRIST], shoulderL = lms[LM.LEFT_SHOULDER];
  const wristR = lms[LM.RIGHT_WRIST], shoulderR = lms[LM.RIGHT_SHOULDER];
  const avgElbow = (angles.elbowL + angles.elbowR) / 2;

  // Rep: wrists above head (y < shoulder y - 0.2) = up; wrists at shoulder = down
  if (wristL.y < shoulderL.y - 0.18 && state.repState !== 'up') {
    state.repState = 'up';
  } else if (wristL.y > shoulderL.y - 0.02 && state.repState === 'up') {
    const now = Date.now();
    if (now - state.lastRepTime > 800) {
      state.lastRepTime = now;
      state.repState = 'neutral';
      countRep(state.formGood);
    }
  }

  // Control check
  if (avgElbow < 60 && state.repState !== 'up') {
    issues.push('Control the descent');
    audioCorrection('press_descent', 'Slow down on the way down — control every centimeter.');
  }

  // Uneven press
  const wristDiff = Math.abs(wristL.y - wristR.y);
  if (wristDiff > 0.06) {
    issues.push('Uneven press — balance it');
    audioCorrection('press_uneven', 'Keep both wrists at the same height — press evenly on both sides.');
  }

  // Full lockout
  if (state.repState === 'up' && avgElbow > 160 && canSpeak('press_lockout', 5000)) {
    speak(randomChoice(['Lock it out! Great rep.', 'Full extension — solid!', 'Nice press — full lockout achieved.']));
  }
}

/* ============================================================
   EXERCISE: BICEP CURL (NEW)
   ============================================================ */
function processCurl(lms, angles, issues) {
  const avgElbow = (angles.elbowL + angles.elbowR) / 2;
  const shoulderL = lms[LM.LEFT_SHOULDER], elbowL = lms[LM.LEFT_ELBOW];
  const shoulderR = lms[LM.RIGHT_SHOULDER], elbowR = lms[LM.RIGHT_ELBOW];
  const hipL = lms[LM.LEFT_HIP], hipR = lms[LM.RIGHT_HIP];

  // Rep state machine: neutral → up (elbow < 55° = contracted) → down (elbow > 155° = extended)
  if (avgElbow < 55 && state.repState !== 'up') {
    state.repState = 'up';
  } else if (avgElbow > 155 && state.repState === 'up') {
    const now = Date.now();
    if (now - state.lastRepTime > 700) {
      state.lastRepTime = now;
      state.repState = 'neutral';
      countRep(state.formGood);
    }
  }

  // CORRECTION 1: Elbows drifting forward (shoulder-elbow X drift)
  const lElbowForward = elbowL.x - shoulderL.x;
  const rElbowForward = elbowR.x - shoulderR.x;
  if ((Math.abs(lElbowForward) > 0.08 || Math.abs(rElbowForward) > 0.08) && avgElbow < 120) {
    issues.push('Keep elbows tucked in');
    audioCorrection('curl_elbow_fwd', 'Keep your elbows pinned to your sides — don\'t let them swing forward.');
  }

  // CORRECTION 2: Swinging momentum (hip movement during curl)
  const hipMidX = (hipL.x + hipR.x) / 2;
  const hipMidY = (hipL.y + hipR.y) / 2;
  if (state.lastHipY !== undefined) {
    const hipYDelta = Math.abs(hipMidY - state.lastHipY);
    if (hipYDelta > 0.02 && avgElbow < 100) {
      issues.push('Avoid swinging — use arms only');
      audioCorrection('curl_swing', 'You\'re swinging your body. Keep your hips still and let your biceps do the work.');
    }
  }
  state.lastHipY = hipMidY;

  // CORRECTION 3: Incomplete extension (rep counted but elbow not extended enough)
  if (state.repState === 'up' && avgElbow > 100 && avgElbow < 145) {
    issues.push('Fully extend your arms');
    audioCorrection('curl_extend', 'Fully extend your arms on the way down to get the full range of motion.');
  }

  // CORRECTION 4: Partial contraction at top
  if (state.repState === 'up' && avgElbow > 65 && avgElbow < 100) {
    issues.push('Curl higher — full contraction');
    audioCorrection('curl_top', 'Curl all the way up — squeeze your biceps at the top of the movement.');
  }

  // CORRECTION 5: Wrist alignment (wrist should stay neutral — approximate via elbow–wrist line)
  // If wrist is significantly below elbow midpoint during contraction phase, flag it
  const wristL = lms[LM.LEFT_WRIST];
  if (avgElbow < 90 && wristL.y > elbowL.y + 0.06) {
    issues.push('Neutral wrist position');
    audioCorrection('curl_wrist', 'Keep your wrists straight and neutral — don\'t let them drop.');
  }

  // Positive reinforcement at peak
  if (state.repState === 'up' && avgElbow < 50 && canSpeak('curl_peak', 4000) && issues.length === 0) {
    speak(randomChoice(['Squeeze at the top!', 'Full contraction — hold it!', 'Beautiful curl! Squeeze and lower slowly.']));
  }
}

/* ============================================================
   REP COUNTING & CELEBRATION
   ============================================================ */
function countRep(goodForm) {
  state.reps++;
  const calPerRep = CAL_PER_REP[state.exercise] || 0.25;
  state.calories += calPerRep;

  if (goodForm) {
    state.goodReps++;
    state.streak++;
    if (state.streak > state.bestStreak) state.bestStreak = state.streak;
  } else {
    state.streak = 0;
  }

  // DOM updates (batch for performance)
  requestAnimationFrame(() => {
    document.getElementById('repCount').textContent = state.reps;
    document.getElementById('goodReps').textContent = state.goodReps;
    document.getElementById('dockRep').textContent = state.reps;
    document.getElementById('statTotal').textContent = state.reps;
    document.getElementById('statGood').textContent = state.goodReps;
    document.getElementById('statCalories').textContent = Math.round(state.calories);
    document.getElementById('streakVal').textContent = state.bestStreak;
    document.getElementById('calorieHeader').textContent = `${Math.round(state.calories)} kcal`;

    const progress = Math.min((state.reps / state.targetReps) * 100, 100);
    document.getElementById('repProgress').style.width = progress + '%';

    const acc = state.reps > 0 ? Math.round((state.goodReps / state.reps) * 100) : 0;
    document.getElementById('accuracyText').textContent = acc + '%';
    document.getElementById('accuracyPct').textContent = acc + '%';
    document.getElementById('accuracyHeader').textContent = acc + '%';

    // Ring fill (circumference ~157.08)
    const offset = 157.08 - (acc / 100) * 157.08;
    document.getElementById('ringFill').style.strokeDashoffset = offset;

    // Ring color by accuracy
    const ringColor = acc >= 90 ? 'var(--purple)' : acc >= 75 ? 'var(--accent)' : acc >= 55 ? 'var(--accent2)' : 'var(--warn)';
    document.getElementById('ringFill').style.stroke = ringColor;

    // Grade
    updateGradeDisplay(acc);
  });

  // Rep flash animation
  const flash = document.getElementById('repFlash');
  document.getElementById('repFlashNum').textContent = state.reps;
  flash.style.opacity = '1';
  gsap.fromTo(flash, { scale:0.8, opacity:0 }, { scale:1, opacity:1, duration:0.2, onComplete: () => {
    gsap.to(flash, { opacity:0, duration:0.4, delay:0.4 });
  }});

  // Rep audio feedback
  const milestone = state.reps % 10 === 0 && state.reps > 0;
  const halfway = state.reps === Math.floor(state.targetReps / 2);

  if (milestone) {
    speak(`${state.reps} reps! Outstanding — you're on fire! Keep this momentum!`, true);
    showGoodFlash(`🔥 ${state.reps} REPS!`);
  } else if (halfway) {
    speak(`Halfway to your target — ${state.reps} reps done. Keep pushing!`);
  } else if (goodForm && canSpeak('rep_fb', 1800)) {
    speak(randomChoice([
      `Rep ${state.reps} — great form!`,
      `${state.reps}. Looking good!`,
      `Nice rep ${state.reps}. Keep it up.`,
      `Solid ${state.reps}. You've got this.`,
      `Rep ${state.reps}. Stay strong!`
    ]));
    if (state.streak >= 5 && state.streak % 5 === 0) {
      speak(`${state.streak} reps in a row with perfect form. Incredible!`);
    }
  } else if (!goodForm && canSpeak('bad_rep', 2500)) {
    speak(randomChoice([
      `Rep ${state.reps} counted — watch your form.`,
      `Keep the form tight on the next one.`,
      `Almost — focus on your technique.`
    ]));
  }

  // Add feedback item
  addFeedback(goodForm ? 'good' : 'warn',
    goodForm ? `Rep ${state.reps} — perfect form ✓` : `Rep ${state.reps} — form needs work`);

  // Check target completion
  if (state.reps === state.targetReps) {
    setTimeout(() => speak(`${state.targetReps} reps complete! Excellent workout. Take a breath — you've earned it.`, true), 500);
  }
}

