  const m = String(Math.floor(elapsed / 60)).padStart(2,'0');
  const s = String(elapsed % 60).padStart(2,'0');
  const grade = getGrade(acc);

  document.getElementById('sumReps').textContent = state.reps;
  document.getElementById('sumGood').textContent = state.goodReps;
  document.getElementById('sumTime').textContent = `${m}:${s}`;
  document.getElementById('sumCal').textContent = Math.round(state.calories);
  document.getElementById('sumAccuracy').textContent = acc + '%';
  document.getElementById('modalBadge').textContent = grade.label;
  document.getElementById('modalBadge').className = `modal-badge ${grade.cls}`;
  document.getElementById('modalTitle') && (document.getElementById('modalTitle').textContent = 'Workout Complete!');
  document.getElementById('modalSubtitle').textContent = `${EXERCISE_META[state.exercise].label} · ${state.reps} reps · ${grade.label}`;

  const modal = document.getElementById('summaryModal');
  modal.classList.add('show');

  // Animate accuracy bar after modal opens
  requestAnimationFrame(() => {
    setTimeout(() => {
      document.getElementById('sumAccFill').style.width = acc + '%';
    }, 200);
  });

  if (state.reps > 0) {
    speak(`Great workout! ${state.reps} reps with ${acc} percent accuracy. You earned the ${grade.label} grade. Well done!`, true);
  }
}

function closeSummary() {
  document.getElementById('summaryModal').classList.remove('show');
}

function resetAndClose() {
  closeSummary();
  resetSession();
}

/* ============================================================
   SIMULATION MODE (fallback / demo)
   ============================================================ */
function runSimulation() {
  const canvas = document.getElementById('poseCanvas');
  const ctx = canvas.getContext('2d');
  let t = 0;
  state.simMode = true;

  addFeedback('info', 'Demo/simulation mode active. Enable camera for real tracking.');
  speak('Simulation mode. I\'m demonstrating perfect squat form. You can still switch exercises.');

  function simFrame() {
    if (!state.poseActive) return;
    t++;
    trackFPS();

    const w = canvas.width, h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    // Simulate smooth squat cycle
    const phase = t * 0.028;
    const squat = (Math.sin(phase) * 0.5 + 0.5); // 0..1
    const cx = 0.5, cy = 0.30;

    // Simulated joint positions
    const lms = buildSimLandmarks(cx, cy, squat, state.exercise);

    // Calculate angles from sim
    const kneeL  = calcAngle(lms[LM.LEFT_HIP], lms[LM.LEFT_KNEE], lms[LM.LEFT_ANKLE]);
    const kneeR  = calcAngle(lms[LM.RIGHT_HIP], lms[LM.RIGHT_KNEE], lms[LM.RIGHT_ANKLE]);
    const hipL   = calcAngle(lms[LM.LEFT_SHOULDER], lms[LM.LEFT_HIP], lms[LM.LEFT_KNEE]);
    const elbowL = calcAngle(lms[LM.LEFT_SHOULDER], lms[LM.LEFT_ELBOW], lms[LM.LEFT_WRIST]);
    const elbowR = calcAngle(lms[LM.RIGHT_SHOULDER], lms[LM.RIGHT_ELBOW], lms[LM.RIGHT_WRIST]);

    const angles = { kneeL, kneeR, hipL, hipR:hipL, elbowL, elbowR };
    state.lastAngles = angles;
    state.confidence = 90 + Math.round(Math.sin(t * 0.05) * 6);

    document.getElementById('confPill').textContent = `${state.confidence}% sim`;

    // Exercise logic
    const issues = [];
    if (state.exercise === 'squat')       processSquat(lms, angles, issues);
    else if (state.exercise === 'pushup') processPushup(lms, angles, issues);
    else if (state.exercise === 'press')  processPress(lms, angles, issues);
    else if (state.exercise === 'curl')   processCurl(lms, angles, issues);

    updateAnglesDisplay(angles);
    state.formGood = issues.length === 0;
    const dot = document.getElementById('statusDot');
    dot.className = issues.length > 0 ? 'status-dot bad' : 'status-dot';
    updateStatus(issues.length > 0 ? issues[0] : 'Good form — keep it up!');

    drawSkeleton(ctx, lms, w, h, state.formGood);
    drawAngleOverlay(ctx, lms, w, h, angles);

    requestAnimationFrame(simFrame);
  }
  simFrame();
}

function buildSimLandmarks(cx, cy, squat, exercise) {
  const s = squat;
  // Base array with all 33 landmarks
  const lms = Array.from({length:33}, () => ({ x:0.5, y:0.5, z:0, visibility:0.9 }));

  if (exercise === 'squat') {
    // Squat: knees bend, hips drop
    lms[0]  = { x:cx, y:cy-0.11, visibility:0.99 };
    lms[11] = { x:cx-0.11, y:cy, visibility:0.99 };
    lms[12] = { x:cx+0.11, y:cy, visibility:0.99 };
    lms[13] = { x:cx-0.15, y:cy+0.10, visibility:0.9 };
    lms[14] = { x:cx+0.15, y:cy+0.10, visibility:0.9 };
    lms[15] = { x:cx-0.17, y:cy+0.22, visibility:0.85 };
    lms[16] = { x:cx+0.17, y:cy+0.22, visibility:0.85 };
    lms[23] = { x:cx-0.08, y:cy+0.22+s*0.09, visibility:0.99 };
    lms[24] = { x:cx+0.08, y:cy+0.22+s*0.09, visibility:0.99 };
    lms[25] = { x:cx-0.10, y:cy+0.40+s*0.05, visibility:0.95 };
    lms[26] = { x:cx+0.10, y:cy+0.40+s*0.05, visibility:0.95 };
    lms[27] = { x:cx-0.09, y:cy+0.56, visibility:0.9 };
    lms[28] = { x:cx+0.09, y:cy+0.56, visibility:0.9 };
  } else if (exercise === 'pushup') {
    // Pushup: angled, elbow bends
    const ph = 0.10 + s * 0.12;
    lms[0]  = { x:cx, y:cy+ph-0.08, visibility:0.95 };
    lms[11] = { x:cx-0.12, y:cy+ph, visibility:0.99 };
    lms[12] = { x:cx+0.12, y:cy+ph, visibility:0.99 };
    lms[13] = { x:cx-0.18, y:cy+ph+0.06+s*0.08, visibility:0.9 };
    lms[14] = { x:cx+0.18, y:cy+ph+0.06+s*0.08, visibility:0.9 };
    lms[15] = { x:cx-0.20, y:cy+ph+0.18, visibility:0.85 };
    lms[16] = { x:cx+0.20, y:cy+ph+0.18, visibility:0.85 };
    lms[23] = { x:cx-0.08, y:cy+ph+0.18, visibility:0.99 };
    lms[24] = { x:cx+0.08, y:cy+ph+0.18, visibility:0.99 };
    lms[25] = { x:cx-0.10, y:cy+ph+0.35, visibility:0.9 };
    lms[26] = { x:cx+0.10, y:cy+ph+0.35, visibility:0.9 };
    lms[27] = { x:cx-0.10, y:cy+ph+0.50, visibility:0.88 };
    lms[28] = { x:cx+0.10, y:cy+ph+0.50, visibility:0.88 };
  } else if (exercise === 'press') {
    // Press: arms go up overhead
    const armY = cy - s * 0.25;
    lms[0]  = { x:cx, y:cy-0.11, visibility:0.99 };
    lms[11] = { x:cx-0.11, y:cy, visibility:0.99 };
    lms[12] = { x:cx+0.11, y:cy, visibility:0.99 };
    lms[13] = { x:cx-0.15, y:cy-0.05+s*0.02, visibility:0.9 };
    lms[14] = { x:cx+0.15, y:cy-0.05+s*0.02, visibility:0.9 };
    lms[15] = { x:cx-0.15, y:armY, visibility:0.88 };
    lms[16] = { x:cx+0.15, y:armY, visibility:0.88 };
    lms[23] = { x:cx-0.08, y:cy+0.22, visibility:0.99 };
    lms[24] = { x:cx+0.08, y:cy+0.22, visibility:0.99 };
    lms[25] = { x:cx-0.09, y:cy+0.40, visibility:0.95 };
    lms[26] = { x:cx+0.09, y:cy+0.40, visibility:0.95 };
    lms[27] = { x:cx-0.09, y:cy+0.56, visibility:0.9 };
    lms[28] = { x:cx+0.09, y:cy+0.56, visibility:0.9 };
  } else { // curl
    // Curl: elbow bends, forearm lifts
    const curlY = cy + 0.10 - s * 0.18;
    lms[0]  = { x:cx, y:cy-0.11, visibility:0.99 };
    lms[11] = { x:cx-0.11, y:cy, visibility:0.99 };
    lms[12] = { x:cx+0.11, y:cy, visibility:0.99 };
    lms[13] = { x:cx-0.13, y:cy+0.14, visibility:0.9 };
    lms[14] = { x:cx+0.13, y:cy+0.14, visibility:0.9 };
    lms[15] = { x:cx-0.14, y:curlY, visibility:0.88 };
    lms[16] = { x:cx+0.14, y:curlY, visibility:0.88 };
    lms[23] = { x:cx-0.08, y:cy+0.22, visibility:0.99 };
    lms[24] = { x:cx+0.08, y:cy+0.22, visibility:0.99 };
    lms[25] = { x:cx-0.09, y:cy+0.40, visibility:0.95 };
    lms[26] = { x:cx+0.09, y:cy+0.40, visibility:0.95 };
    lms[27] = { x:cx-0.09, y:cy+0.56, visibility:0.9 };
    lms[28] = { x:cx+0.09, y:cy+0.56, visibility:0.9 };
  }
  return lms;
}

