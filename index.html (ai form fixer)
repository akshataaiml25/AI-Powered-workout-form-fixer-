  LEFT_KNEE:25,     RIGHT_KNEE:26,
  LEFT_ANKLE:27,    RIGHT_ANKLE:28
};

// Exercise definitions (angle display labels)
const EXERCISE_META = {
  squat:  { label:'🏋️ Squats',  angA:'Knee L', angB:'Knee R', angC:'Hip L', angD:'Hip R',   cal:0.32 },
  pushup: { label:'💪 Push-ups', angA:'Elbow L',angB:'Elbow R',angC:'Body', angD:'Shoulder',cal:0.29 },
  press:  { label:'🙌 Press',    angA:'Elbow L',angB:'Elbow R',angC:'Trunk',angD:'Wrist',    cal:0.22 },
  curl:   { label:'🦾 Curls',    angA:'Elbow L',angB:'Elbow R',angC:'Shoulder',angD:'Body',  cal:0.18 },
};

/* ============================================================
   VOICE COOLDOWNS — prevent repeat nagging
   ============================================================ */
const voiceCooldowns = {};
function canSpeak(key, cooldownMs = 4000) {
  const now = Date.now();
  if (voiceCooldowns[key] && (now - voiceCooldowns[key]) < cooldownMs) return false;
  voiceCooldowns[key] = now;
  return true;
}

/* ============================================================
   NAVIGATION
   ============================================================ */
function startApp() {
  gsap.to('#landing', { opacity:0, duration:0.4, onComplete: () => {
