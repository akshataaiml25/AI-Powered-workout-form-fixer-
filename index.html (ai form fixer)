/* ============================================================
   SKELETON DRAWING
   ============================================================ */
const CONNECTIONS = [
  [LM.LEFT_SHOULDER,  LM.RIGHT_SHOULDER],
  [LM.LEFT_SHOULDER,  LM.LEFT_ELBOW],
  [LM.LEFT_ELBOW,     LM.LEFT_WRIST],
  [LM.RIGHT_SHOULDER, LM.RIGHT_ELBOW],
  [LM.RIGHT_ELBOW,    LM.RIGHT_WRIST],
  [LM.LEFT_SHOULDER,  LM.LEFT_HIP],
  [LM.RIGHT_SHOULDER, LM.RIGHT_HIP],
  [LM.LEFT_HIP,       LM.RIGHT_HIP],
  [LM.LEFT_HIP,       LM.LEFT_KNEE],
  [LM.RIGHT_HIP,      LM.RIGHT_KNEE],
  [LM.LEFT_KNEE,      LM.LEFT_ANKLE],
  [LM.RIGHT_KNEE,     LM.RIGHT_ANKLE],
  [LM.NOSE,           LM.LEFT_SHOULDER],
  [LM.NOSE,           LM.RIGHT_SHOULDER],
];

const KEY_JOINTS = new Set([11,12,13,14,15,16,23,24,25,26,27,28]);

function drawSkeleton(ctx, landmarks, w, h, goodForm) {
  const baseColor = goodForm ? '#00d4aa' : '#ff4f6b';
  const glowColor = goodForm ? 'rgba(0,212,170,0.55)' : 'rgba(255,79,107,0.55)';

  ctx.save();

  // Connections
  ctx.lineWidth = 2.8;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.shadowColor = glowColor;
  ctx.shadowBlur = 10;

  CONNECTIONS.forEach(([a, b]) => {
    const lmA = landmarks[a], lmB = landmarks[b];
    if (!lmA || !lmB) return;
    if ((lmA.visibility || 0) < 0.35 || (lmB.visibility || 0) < 0.35) return;

    ctx.strokeStyle = baseColor;
    ctx.globalAlpha = Math.min(lmA.visibility, lmB.visibility);
    ctx.beginPath();
    ctx.moveTo(lmA.x * w, lmA.y * h);
    ctx.lineTo(lmB.x * w, lmB.y * h);
    ctx.stroke();
  });

  ctx.globalAlpha = 1;

  // Joints
  landmarks.forEach((lm, i) => {
    if ((lm.visibility || 0) < 0.35) return;
    const isKey = KEY_JOINTS.has(i);
    const r = isKey ? 5 : 3;
    ctx.beginPath();
    ctx.arc(lm.x * w, lm.y * h, r, 0, Math.PI * 2);
    ctx.fillStyle = isKey ? baseColor : 'rgba(255,255,255,0.5)';
    ctx.globalAlpha = lm.visibility || 1;
    ctx.fill();
  });

  ctx.restore();
}

function drawAngleOverlay(ctx, landmarks, w, h, angles) {
  ctx.save();
  ctx.font = `600 11px ${getComputedStyle(document.body).getPropertyValue('--font-mono') || 'monospace'}`;
  ctx.fillStyle = 'rgba(255,255,255,0.92)';
  ctx.shadowColor = 'rgba(0,0,0,0.8)';
  ctx.shadowBlur = 4;

  const pts = [
    { lm: LM.LEFT_KNEE,  val: angles.kneeL,  ox: -36, oy: -10 },
    { lm: LM.RIGHT_KNEE, val: angles.kneeR,  ox:  8,  oy: -10 },
  ];

  if (state.exercise === 'pushup' || state.exercise === 'press' || state.exercise === 'curl') {
    pts.length = 0;
    pts.push({ lm: LM.LEFT_ELBOW,  val: angles.elbowL, ox: -40, oy: -8 });
    pts.push({ lm: LM.RIGHT_ELBOW, val: angles.elbowR, ox:  8,  oy: -8 });
  }

  pts.forEach(({ lm: lmIdx, val, ox, oy }) => {
    if (!landmarks[lmIdx]) return;
    const lmPt = landmarks[lmIdx];
    if ((lmPt.visibility || 0) < 0.4) return;
    ctx.fillText(`${Math.round(val)}°`, lmPt.x * w + ox, lmPt.y * h + oy);
  });

  ctx.restore();
}

