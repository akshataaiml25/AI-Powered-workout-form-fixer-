  if ('speechSynthesis' in window) {
    speechSynthesis.getVoices();
  }
  // Animate landing on load
  gsap.from('.logo-badge', { y:-15, opacity:0, duration:0.5 });
  gsap.from('.hero h1', { y:25, opacity:0, duration:0.6, delay:0.1 });
  gsap.from('.hero-sub', { y:20, opacity:0, duration:0.6, delay:0.2 });
  gsap.from('.hero-btns', { y:15, opacity:0, duration:0.5, delay:0.3 });
  gsap.from('.body-preview', { scale:0.8, opacity:0, duration:0.6, delay:0.15 });
  gsap.from('.feat-card', { y:20, opacity:0, duration:0.5, delay:0.4, stagger:0.08 });
});

// Pause speech when tab is hidden
document.addEventListener('visibilitychange', () => {
  if (!('speechSynthesis' in window)) return;
  if (document.hidden) {
    speechSynthesis.pause();
  } else {
    speechSynthesis.resume();
    // If stuck, reset
    if (speechActive) {
      setTimeout(() => { speechActive = false; drainQueue(); }, 500);
    }
  }
});

// Handle stuck speech on Chrome (Chrome pauses after 15s)
setInterval(() => {
  if (speechActive && speechSynthesis.speaking) {
    speechSynthesis.resume();
  }
  if (speechActive && !speechSynthesis.speaking && !speechSynthesis.pending) {
    speechActive = false;
    drainQueue();
  }
}, 3000);
