/* ============================================================
   VOICE SYSTEM
   ============================================================ */
let speechQueue = [];
let speechActive = false;
let speechStuck = 0;  // detect stuck queue

function initVoice() {
  if (!('speechSynthesis' in window)) return;
  // Trigger voice list load
  window.speechSynthesis.getVoices();
  setTimeout(() => {
    const voices = speechSynthesis.getVoices();
    populateVoices(voices);
  }, 500);
  speechSynthesis.onvoiceschanged = () => populateVoices(speechSynthesis.getVoices());
}

function populateVoices(voices) {
  if (!voices.length) return;
  const sel = document.getElementById('voiceSelect');
  // Clear old options except default
  while (sel.options.length > 1) sel.remove(1);

  voices.forEach((v, i) => {
    const opt = document.createElement('option');
    opt.value = i;
    opt.textContent = v.name.replace('Microsoft ', '').replace(' Online (Natural)', '').substring(0, 22);
    sel.appendChild(opt);
  });

  // Auto-select best English voice (prefer natural/neural voices)
  const preferredNames = ['Aria','Jenny','Guy','Emma','Brian','Google UK English Female','Samantha'];
  let bestIdx = -1;
  for (const name of preferredNames) {
    const idx = voices.findIndex(v => v.name.includes(name));
    if (idx >= 0) { bestIdx = idx; break; }
  }
  if (bestIdx < 0) bestIdx = voices.findIndex(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('female'));
  if (bestIdx < 0) bestIdx = voices.findIndex(v => v.lang.startsWith('en'));
  if (bestIdx >= 0) {
    sel.value = bestIdx;
    state.selectedVoice = voices[bestIdx];
  }
}

function setVoice(idx) {
  if (idx === '') { state.selectedVoice = null; return; }
  const voices = speechSynthesis.getVoices();
  state.selectedVoice = voices[parseInt(idx)] || null;
}

function setVolume(v) { state.volume = parseFloat(v); }

function toggleMute() {
  state.muted = !state.muted;
  const btn = document.getElementById('muteBtn');
  btn.textContent = state.muted ? '🔇 Muted' : '🔊 Audio';
  btn.classList.toggle('active', state.muted);
  document.getElementById('audioOrb').textContent = state.muted ? '🔇' : '🎙️';
  document.getElementById('dockOrb').textContent = state.muted ? '🔇' : '🎙️';
  if (state.muted) { speechSynthesis.cancel(); speechQueue = []; speechActive = false; }
}

function speak(text, priority = false) {
  if (state.muted || !('speechSynthesis' in window)) return;
  if (priority) {
    speechSynthesis.cancel();
    speechQueue = [];
    speechActive = false;
  }
  // Don't queue duplicate consecutive messages
  if (speechQueue[speechQueue.length - 1] === text) return;
  speechQueue.push(text);
  drainQueue();
}

function drainQueue() {
  // Reset stuck speech state after 8 seconds
  if (speechActive) {
    speechStuck++;
    if (speechStuck > 40) { speechActive = false; speechStuck = 0; }
    return;
  }
  if (!speechQueue.length) return;
  speechStuck = 0;

  const text = speechQueue.shift();
  const utt = new SpeechSynthesisUtterance(text);
  utt.rate = 1.05;
  utt.pitch = 1.02;
  utt.volume = state.volume;
  if (state.selectedVoice) utt.voice = state.selectedVoice;

  utt.onstart = () => { speechActive = true; setAudioOrb(true, text); };
  utt.onend = () => { speechActive = false; setAudioOrb(false); setTimeout(drainQueue, 250); };
  utt.onerror = () => { speechActive = false; setAudioOrb(false); setTimeout(drainQueue, 250); };

  try { speechSynthesis.speak(utt); }
  catch(e) { speechActive = false; }
}

function setAudioOrb(active, text = '') {
  const ids = ['audioOrb','dockOrb'];
  const orb = document.getElementById('audioOrb');
  const dOrb = document.getElementById('dockOrb');
  const txt = document.getElementById('audioText');
  const wave = document.getElementById('waveform');

  if (active) {
    orb.classList.add('speaking');
    dOrb.classList.add('speaking');
    txt.classList.add('speaking');
    txt.textContent = '"' + text + '"';
    wave.classList.add('active');
  } else {
    orb.classList.remove('speaking');
    dOrb.classList.remove('speaking');
    txt.classList.remove('speaking');
    txt.textContent = 'Ready to coach...';
    wave.classList.remove('active');
  }
}

/* ============================================================
   CAMERA & MEDIAPIPE
   ============================================================ */
let videoStream = null;
let mpPose = null;
let mpCamera = null;
let resizeObserver = null;

async function initCamera() {
  const btn = document.getElementById('startCameraBtn');
  const demoBtn = document.getElementById('demoModeBtn');
  const spinner = document.getElementById('cameraSpinner');
  const err = document.getElementById('camError');

  btn.style.display = 'none';
  demoBtn.style.display = 'none';
  spinner.style.display = 'block';
  err.style.display = 'none';

  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: 'user',
        width: { ideal: 1280, min: 640 },
        height: { ideal: 720, min: 480 }
      },
      audio: false
    });
    videoStream = stream;
    const video = document.getElementById('videoEl');
    video.srcObject = stream;

    await new Promise((res, rej) => {
      video.onloadedmetadata = res;
      video.onerror = rej;
    });
    await video.play();

    // Show session
    document.getElementById('startOverlay').style.display = 'none';
    document.getElementById('hud').style.display = 'flex';
    document.getElementById('statusBar').style.display = 'flex';
    document.getElementById('gradeBadge').style.display = 'block';

    state.poseActive = true;
    setupCanvas();
    startCountdown(() => {
      initMediaPipe();
      speak("Camera ready. Let's work. Start when you're comfortable.", false);
    });

  } catch(e) {
    spinner.style.display = 'none';
    btn.style.display = 'block';
    demoBtn.style.display = 'block';
    err.style.display = 'block';
    err.textContent = e.name === 'NotAllowedError'
      ? '⚠ Camera permission denied. Please allow camera access in browser settings, then try again.'
      : e.name === 'NotFoundError'
        ? '⚠ No camera found. Connect a camera or try Demo Mode.'
        : `⚠ Camera error: ${e.message}`;
  }
}

function stopCamera() {
  state.poseActive = false;
  if (mpCamera) { try { mpCamera.stop(); } catch(e){} mpCamera = null; }
  if (mpPose) { try { mpPose.close(); } catch(e){} mpPose = null; }
  if (videoStream) { videoStream.getTracks().forEach(t => t.stop()); videoStream = null; }
  if (resizeObserver) { resizeObserver.disconnect(); resizeObserver = null; }
  speechSynthesis.cancel();
  speechQueue = [];
  speechActive = false;
}

function setupCanvas() {
  const canvas = document.getElementById('poseCanvas');
  const video = document.getElementById('videoEl');

  function resize() {
    const rect = video.getBoundingClientRect();
    canvas.width = rect.width || 640;
    canvas.height = rect.height || 480;
  }
  resize();

  resizeObserver = new ResizeObserver(resize);
  resizeObserver.observe(video);
}

function initMediaPipe() {
  const video = document.getElementById('videoEl');

  if (typeof Pose === 'undefined') {
    console.warn('MediaPipe Pose not available – falling back to simulation');
    runSimulation();
    return;
  }

  mpPose = new Pose({
    locateFile: f => `https://cdn.jsdelivr.net/npm/@mediapipe/pose/${f}`
  });

  mpPose.setOptions({
    modelComplexity: 1,
    smoothLandmarks: true,
    enableSegmentation: false,
    smoothSegmentation: false,
    minDetectionConfidence: 0.55,
    minTrackingConfidence: 0.55
  });

  mpPose.onResults(onPoseResults);

  if (typeof Camera !== 'undefined') {
    mpCamera = new Camera(video, {
      onFrame: async () => {
        if (mpPose && state.poseActive) await mpPose.send({ image: video });
      },
      width: 1280, height: 720
    });
    mpCamera.start();
  } else {
    // Fallback: process frames manually
    const processFrame = async () => {
      if (!state.poseActive) return;
      if (mpPose) await mpPose.send({ image: video });
      requestAnimationFrame(processFrame);
    };
    requestAnimationFrame(processFrame);
  }
}

/* Initialise from "Demo Mode" button (no camera) */
function initSimulation() {
  document.getElementById('startOverlay').style.display = 'none';
  document.getElementById('hud').style.display = 'flex';
  document.getElementById('statusBar').style.display = 'flex';
  document.getElementById('gradeBadge').style.display = 'block';
  state.poseActive = true;
