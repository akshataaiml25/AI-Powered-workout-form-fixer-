<script>
/* ============================================================
   STATE MANAGEMENT
   ============================================================ */
const state = {
  exercise: 'squat',
  reps: 0,
  goodReps: 0,
  corrections: 0,
  repState: 'neutral',   // neutral | down | up (varies per exercise)
  lastRepTime: 0,
  sessionStart: null,
