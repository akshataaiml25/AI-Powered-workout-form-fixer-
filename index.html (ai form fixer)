<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>AI Form Fixer — Real-time Workout Coach</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<style>
/* ============================================================
   DESIGN TOKENS & RESET
   ============================================================ */
:root {
  --bg: #080a0d;
  --surface: #0e1117;
  --surface2: #141820;
  --surface3: #1a1f2b;
  --border: rgba(255,255,255,0.06);
  --border2: rgba(255,255,255,0.1);
  --border3: rgba(255,255,255,0.16);
  --text: #eef0f4;
  --text2: #a8b0be;
  --muted: #5a6272;
  --accent: #00d4aa;
  --accent-dim: rgba(0,212,170,0.12);
  --accent-glow: rgba(0,212,170,0.35);
  --accent2: #3b9eff;
  --accent2-dim: rgba(59,158,255,0.12);
  --warn: #ff7c4d;
  --warn-dim: rgba(255,124,77,0.12);
  --good: #22d672;
  --good-dim: rgba(34,214,114,0.12);
  --bad: #ff4f6b;
  --bad-dim: rgba(255,79,107,0.12);
  --purple: #a78bfa;
  --font-main: 'Outfit', sans-serif;
  --font-mono: 'IBM Plex Mono', monospace;
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

html { font-size: 16px; }

body {
  font-family: var(--font-main);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}

/* ============================================================
   UTILITY
   ============================================================ */
.glass {
  background: rgba(14,17,23,0.7);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.neon-border {
  border: 1px solid rgba(0,212,170,0.3);
  box-shadow: 0 0 12px rgba(0,212,170,0.1), inset 0 0 12px rgba(0,212,170,0.04);
}

/* ============================================================
   LANDING PAGE
   ============================================================ */
#landing {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,212,170,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,212,170,0.035) 1px, transparent 1px);
  background-size: 64px 64px;
  pointer-events: none;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
}

.grid-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 60% 50% at 50% 30%, rgba(0,212,170,0.06) 0%, transparent 70%);
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60px 24px 48px;
  position: relative;
  z-index: 1;
}

.logo-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(0,212,170,0.08);
  border: 1px solid rgba(0,212,170,0.22);
  border-radius: 100px;
  padding: 6px 18px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 36px;
  animation: badge-in 0.6s ease both;
}

@keyframes badge-in {
  from { opacity:0; transform: translateY(-12px); }
  to { opacity:1; transform: translateY(0); }
}

.pulse-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 8px var(--accent);
  animation: pulse-dot 2s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%,100% { opacity:1; transform: scale(1); box-shadow: 0 0 8px var(--accent); }
  50% { opacity:0.5; transform: scale(0.75); box-shadow: 0 0 4px var(--accent); }
}

.hero h1 {
  font-size: clamp(44px, 7vw, 84px);
  font-weight: 900;
  line-height: 1.0;
  letter-spacing: -0.04em;
  margin-bottom: 20px;
  animation: hero-in 0.7s 0.1s ease both;
}

@keyframes hero-in {
  from { opacity:0; transform: translateY(20px); }
  to { opacity:1; transform: translateY(0); }
}

.hero h1 .accent { color: var(--accent); }
.hero h1 .accent-blue { color: var(--accent2); }

.hero-sub {
  font-size: clamp(15px, 2vw, 18px);
  color: var(--text2);
  max-width: 480px;
  line-height: 1.65;
  margin-bottom: 40px;
  font-weight: 400;
  animation: hero-in 0.7s 0.2s ease both;
}

.hero-btns {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 60px;
  animation: hero-in 0.7s 0.3s ease both;
}

.btn-primary {
  background: var(--accent);
  color: #000;
  border: none;
  border-radius: 12px;
  padding: 15px 32px;
  font-size: 15px;
  font-weight: 700;
  font-family: var(--font-main);
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: -0.01em;
  position: relative;
  overflow: hidden;
}

.btn-primary::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, transparent 60%);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 40px rgba(0,212,170,0.4);
}

.btn-primary:active { transform: translateY(0); }

.btn-secondary {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--border2);
  border-radius: 12px;
  padding: 15px 32px;
  font-size: 15px;
  font-weight: 500;
  font-family: var(--font-main);
  cursor: pointer;
  transition: all 0.2s;
}

.btn-secondary:hover { border-color: rgba(0,212,170,0.4); color: var(--accent); background: var(--accent-dim); }

/* Animated hero figure */
.body-preview {
  width: 110px;
  height: 185px;
  margin-bottom: 48px;
  animation: hero-in 0.7s 0.15s ease both;
}

.body-preview svg { width: 100%; height: 100%; }

.sk-line {
  stroke: var(--accent);
  stroke-width: 2.5;
  stroke-linecap: round;
  fill: none;
  filter: drop-shadow(0 0 4px rgba(0,212,170,0.7));
  animation: sk-pulse 2.4s ease-in-out infinite;
}

.sk-joint {
  fill: var(--accent);
  filter: drop-shadow(0 0 6px rgba(0,212,170,0.9));
  animation: sk-pulse 2.4s ease-in-out infinite;
}

@keyframes sk-pulse {
  0%,100% { opacity:1; }
  50% { opacity:0.55; }
}

/* Feature grid */
.features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 12px;
  max-width: 760px;
  width: 100%;
  margin: 0 auto;
  animation: hero-in 0.7s 0.4s ease both;
}

.feat-card {
  background: rgba(14,17,23,0.6);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 18px;
  text-align: left;
  transition: all 0.25s;
  position: relative;
  overflow: hidden;
}

.feat-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(0,212,170,0.3), transparent);
  opacity: 0;
  transition: opacity 0.25s;
}

.feat-card:hover { border-color: rgba(0,212,170,0.25); transform: translateY(-2px); }
.feat-card:hover::before { opacity: 1; }

.feat-icon { font-size: 22px; margin-bottom: 10px; }
.feat-card h3 { font-size: 13px; font-weight: 700; margin-bottom: 5px; letter-spacing: -0.01em; }
.feat-card p { font-size: 12px; color: var(--muted); line-height: 1.5; }


/* ============================================================
   WORKOUT APP
   ============================================================ */
#app {
  display: none;
  min-height: 100vh;
  flex-direction: column;
}

#app.active { display: flex; }

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 18px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  gap: 12px;
  min-height: 52px;
}

.app-title {
  font-size: 15px;
  font-weight: 800;
  color: var(--accent);
  letter-spacing: -0.03em;
  white-space: nowrap;
}

.header-stats {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  justify-content: center;
}

.hstat {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--muted);
}

.hstat-val {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 500;
  color: var(--text2);
}

.hstat-val.calories { color: var(--warn); }

.header-controls {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.icon-btn {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 6px 12px;
  color: var(--text2);
  cursor: pointer;
  font-size: 12px;
  font-weight: 500;
  font-family: var(--font-main);
  transition: all 0.2s;
  white-space: nowrap;
  letter-spacing: -0.01em;
}

.icon-btn:hover { border-color: rgba(0,212,170,0.4); color: var(--accent); background: var(--accent-dim); }
.icon-btn.active { background: rgba(0,212,170,0.15); border-color: var(--accent); color: var(--accent); }

/* ============================================================
   WORKOUT LAYOUT
   ============================================================ */
.workout-main {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 288px;
  overflow: hidden;
  height: calc(100vh - 52px);
}

@media (max-width: 768px) {
  .workout-main {
    grid-template-columns: 1fr;
    height: auto;
  }
  .sidebar { display: none; }
}

/* ============================================================
   CAMERA AREA
   ============================================================ */
.camera-area {
  position: relative;
  background: #000;
  overflow: hidden;
  min-height: 300px;
}

#videoEl {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scaleX(-1);
  display: block;
}

#poseCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: scaleX(-1);
  pointer-events: none;
}

/* Start overlay */
.start-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(8,10,13,0.92);
  z-index: 10;
  gap: 18px;
  padding: 24px;
}

.cam-icon-ring {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  border: 2px dashed rgba(0,212,170,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34px;
  animation: spin-slow 10s linear infinite;
  position: relative;
}

.cam-icon-ring::after {
  content: '';
  position: absolute;
  inset: -6px;
  border-radius: 50%;
  border: 1px solid rgba(0,212,170,0.12);
}

@keyframes spin-slow { to { transform: rotate(360deg); } }

.start-overlay h2 { font-size: 18px; font-weight: 700; letter-spacing: -0.02em; }
.start-overlay p { font-size: 13px; color: var(--text2); text-align: center; max-width: 260px; line-height: 1.55; }

.cam-tips {
  display: flex;
  flex-direction: column;
  gap: 6px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 14px;
  max-width: 260px;
  width: 100%;
}

.cam-tip {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11.5px;
  color: var(--text2);
}

.cam-tip-icon { font-size: 14px; flex-shrink: 0; }

.spinner {
  width: 30px; height: 30px;
  border: 2.5px solid rgba(0,212,170,0.15);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.perm-error {
  color: var(--bad);
  font-size: 12.5px;
  text-align: center;
  padding: 10px 14px;
  background: var(--bad-dim);
  border-radius: 8px;
  border: 1px solid rgba(255,79,107,0.25);
  max-width: 280px;
  line-height: 1.5;
}

/* HUD corner */
.hud-corner {
  position: absolute;
  top: 14px;
  left: 14px;
  display: flex;
  gap: 6px;
  align-items: center;
  z-index: 5;
}

.hud-pill {
  background: rgba(8,10,13,0.75);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 100px;
  padding: 4px 11px;
  font-size: 11px;
  font-family: var(--font-mono);
  font-weight: 500;
  letter-spacing: 0.02em;
}

.hud-fps { color: var(--good); }
.hud-conf { color: var(--accent2); }

/* Rep flash overlay */
.rep-flash-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  pointer-events: none;
  opacity: 0;
  z-index: 8;
}

.rep-flash-num {
  font-size: 96px;
  font-weight: 900;
  color: var(--accent);
  text-shadow: 0 0 50px rgba(0,212,170,0.8), 0 0 20px rgba(0,212,170,0.5);
  line-height: 1;
  letter-spacing: -0.05em;
}

.rep-flash-label {
  font-size: 14px;
  color: var(--accent);
  font-weight: 700;
  letter-spacing: 0.15em;
  text-shadow: 0 0 20px rgba(0,212,170,0.6);
}

/* Grade badge on camera */
.grade-badge {
  position: absolute;
  top: 14px;
  right: 14px;
  background: rgba(8,10,13,0.75);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 700;
  z-index: 5;
  display: none;
  letter-spacing: 0.04em;
}

.grade-badge.beginner { color: var(--warn); border-color: rgba(255,124,77,0.3); }
.grade-badge.intermediate { color: var(--accent2); border-color: rgba(59,158,255,0.3); }
.grade-badge.advanced { color: var(--accent); border-color: rgba(0,212,170,0.3); }
.grade-badge.elite { color: var(--purple); border-color: rgba(167,139,250,0.3); }

/* Correction flash */
.correction-flash {
  position: absolute;
  bottom: 68px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255,79,107,0.9);
  backdrop-filter: blur(8px);
  color: #fff;
  padding: 9px 20px;
  border-radius: 100px;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.25s;
  pointer-events: none;
  z-index: 6;
  border: 1px solid rgba(255,79,107,0.4);
  max-width: 90%;
  text-overflow: ellipsis;
  overflow: hidden;
}

.correction-flash.show { opacity: 1; }

/* Good form flash */
.good-flash {
  position: absolute;
  bottom: 68px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(34,214,114,0.9);
  backdrop-filter: blur(8px);
  color: #000;
  padding: 9px 20px;
  border-radius: 100px;
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.25s;
  pointer-events: none;
  z-index: 6;
}

.good-flash.show { opacity: 1; }

/* Status bar */
.status-bar {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 14px 16px;
  background: linear-gradient(transparent, rgba(8,10,13,0.9));
  display: flex;
  align-items: center;
  justify-content: space-between;
  display: none;
}

.posture-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
}

.status-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--good);
  box-shadow: 0 0 10px var(--good);
  flex-shrink: 0;
}

.status-dot.bad { background: var(--bad); box-shadow: 0 0 10px var(--bad); }
.status-dot.warn { background: var(--warn); box-shadow: 0 0 10px var(--warn); }

/* Countdown overlay */
.countdown-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(8,10,13,0.88);
  z-index: 9;
  display: none;
}

.countdown-num {
  font-size: 140px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.05em;
  color: var(--accent);
  text-shadow: 0 0 60px rgba(0,212,170,0.6);
}

.countdown-label {
  font-size: 18px;
  color: var(--text2);
  margin-top: 12px;
  font-weight: 500;
}


/* ============================================================
   SIDEBAR
   ============================================================ */
.sidebar {
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border-left: 1px solid var(--border);
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: thin;
  scrollbar-color: var(--border2) transparent;
}

.sidebar::-webkit-scrollbar { width: 4px; }
.sidebar::-webkit-scrollbar-track { background: transparent; }
.sidebar::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 100px; }

.sidebar-section {
  padding: 14px 16px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.sidebar-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 12px;
}

/* Exercise selector */
.exercise-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.exercise-btn {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 8px;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
  font-family: var(--font-main);
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: -0.01em;
  position: relative;
  overflow: hidden;
}

.exercise-btn .ex-icon {
  font-size: 20px;
  display: block;
  margin-bottom: 4px;
}

.exercise-btn:hover { border-color: rgba(0,212,170,0.35); color: var(--text); }

.exercise-btn.selected {
  border-color: var(--accent);
  background: var(--accent-dim);
  color: var(--accent);
  box-shadow: 0 0 16px rgba(0,212,170,0.1);
}

/* Reps */
.rep-counter-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.rep-big {
  font-size: 58px;
  font-weight: 900;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: var(--accent);
  letter-spacing: -0.04em;
  font-family: var(--font-mono);
  text-shadow: 0 0 30px rgba(0,212,170,0.25);
}

.rep-details { text-align: right; }
.rep-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
.rep-good-val { font-size: 20px; font-weight: 700; color: var(--good); font-family: var(--font-mono); }

.rep-progress {
  height: 4px;
  background: var(--surface3);
  border-radius: 100px;
  overflow: hidden;
  margin-bottom: 8px;
}

.rep-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), rgba(0,212,170,0.6));
  border-radius: 100px;
  transition: width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 0 8px rgba(0,212,170,0.4);
}

.rep-score-row {
  display: flex;
  justify-content: space-between;
  font-size: 11.5px;
}

.rep-score-label { color: var(--muted); }
.rep-score-val { font-weight: 600; color: var(--good); }

/* Accuracy ring */
.accuracy-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.ring-svg {
  width: 60px; height: 60px;
  transform: rotate(-90deg);
  flex-shrink: 0;
}

.ring-bg { fill: none; stroke: var(--surface3); stroke-width: 5.5; }
.ring-fill {
  fill: none;
  stroke: var(--accent);
  stroke-width: 5.5;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.5s ease, stroke 0.3s;
  filter: drop-shadow(0 0 4px rgba(0,212,170,0.5));
}

.accuracy-info .pct {
  font-size: 24px;
  font-weight: 800;
  font-family: var(--font-mono);
  letter-spacing: -0.03em;
}

.accuracy-info .sub { font-size: 10.5px; color: var(--muted); margin-top: 2px; }
.accuracy-info .grade-text {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
  margin-top: 4px;
}

/* Joint angles */
.angles-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

