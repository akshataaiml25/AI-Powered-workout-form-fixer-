.wave-bar:nth-child(6) { animation-delay: 0.2s; }
.wave-bar:nth-child(7) { animation-delay: 0.06s; }
.wave-bar:nth-child(8) { animation-delay: 0.14s; }
.wave-bar:nth-child(9) { animation-delay: 0.1s; }
